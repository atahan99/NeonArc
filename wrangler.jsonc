// Deploys public/ as static assets on Cloudflare (a Worker with no script). Only public/ is served.
{
  "name": "neonarc",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public"
  },
  "routes": [
    {
      "pattern": "neonarc.cybrsmr.xyz",
      "custom_domain": true
    }
  ]
}
